{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-mobile-product-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mobile-product-carousel.js' | asset_url }}" defer="defer"></script>

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #Carousel-{{ section.id }} {
    --concept-carousel-columns-desktop: {{ section.settings.columns_desktop }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign carousel_label = section.settings.heading | strip_html | strip
  if carousel_label == blank
    assign carousel_label = 'general.slider.name' | t
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <mobile-product-carousel
    id="Carousel-{{ section.id }}"
    class="concept-carousel page-width section-{{ section.id }}-padding isolate"
  >
    {%- if section.settings.heading != blank or section.settings.show_arrows -%}
      <div class="concept-carousel__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="concept-carousel__heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- else -%}
          <span></span>
        {%- endif -%}

        {%- if section.settings.show_arrows -%}
          <div class="concept-carousel__controls concept-carousel__controls--visible">
            <button
              type="button"
              class="concept-carousel__arrow concept-carousel__arrow--prev"
              data-carousel-prev
              aria-controls="CarouselTrack-{{ section.id }}"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
            >
              <span class="icon" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            </button>
            <button
              type="button"
              class="concept-carousel__arrow concept-carousel__arrow--next"
              data-carousel-next
              aria-controls="CarouselTrack-{{ section.id }}"
              aria-label="{{ 'general.slider.next_slide' | t }}"
            >
              <span class="icon" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      id="CarouselTrack-{{ section.id }}"
      class="concept-carousel__track"
      data-carousel-track
      role="list"
      tabindex="0"
      aria-label="{{ carousel_label | escape }}"
    >
      {%- liquid
        # The first card emits the shared card styles; the rest skip them.
        assign skip_card_product_styles = false
      -%}
      {%- for block in section.blocks -%}
        <li class="concept-carousel__slide" data-carousel-slide {{ block.shopify_attributes }}>
          {% render 'card-product',
            card_product: block.settings.product,
            media_aspect_ratio: section.settings.image_ratio,
            show_secondary_image: section.settings.show_secondary_image,
            show_vendor: section.settings.show_vendor,
            show_rating: section.settings.show_rating,
            skip_styles: skip_card_product_styles,
            quick_add: section.settings.quick_add,
            section_id: section.id,
            product_view_context: 'collection'
          %}
        </li>
        {%- assign skip_card_product_styles = true -%}
      {%- endfor -%}
    </ul>
  </mobile-product-carousel>
</div>

{% schema %}
{
  "name": "Mobile product carousel",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Featured products",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Cards visible on desktop"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "default": true,
      "label": "Show arrow controls on desktop",
      "info": "On mobile the carousel is always swipeable."
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show product rating"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "none",
      "label": "Quick add",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" },
        { "value": "bulk", "label": "Bulk" }
      ]
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile product carousel",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
